# Deep Research Agent runtime environment
# Install as /home/researcher/.config/deep-research/deep-research.env (mode 600).
# Secrets must stay outside the git repo.
#
# Leave a key empty to skip that backend. With both empty, the agent still
# works through the local SearXNG fallback configured in config.yaml.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SERPER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Node is required by the Playwright MCP browser fallback (browser.enabled).
# Point this at the active nvm node bin directory on this machine.
PATH=/home/researcher/.nvm/versions/node/v24.18.0/bin:/home/researcher/.local/bin:/usr/local/bin:/usr/bin:/bin
PYTHONUNBUFFERED=1
