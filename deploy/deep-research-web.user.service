[Unit]
Description=Deep Research Agent (web UI, user service)
Documentation=https://github.com/kunle12/deep_research
# User services cannot depend on system units (searxng.service is not visible
# here), so readiness is enforced with the ExecStartPre wait loop instead.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/researcher/deep_research
EnvironmentFile=-/home/researcher/.config/deep-research/deep-research.env
Environment=PYTHONUNBUFFERED=1

# Wait for SearXNG to answer on 127.0.0.1:8888 before starting. Fail if it
# never comes up so systemd retries after SearXNG finishes starting at boot.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 120); do curl -fsS -m 2 -o /dev/null http://127.0.0.1:8888/ && exit 0; sleep 1; done; echo "SearXNG did not become ready on 127.0.0.1:8888 after 120s" >&2; exit 1'

# Single worker: research jobs are tracked in memory, so multiple uvicorn
# workers would split job state and make progress/status unreliable.
# --no-proxy-headers: trusted-header SSO checks request.client.host, so
# uvicorn must report the TCP peer. The default trusts X-Forwarded-For
# from 127.0.0.1, which a local user could use to impersonate the proxy.
ExecStart=/home/researcher/deep_research/.venv/bin/python -m uvicorn deep_research.webui.app:app --host 0.0.0.0 --port 8080 --workers 1 --log-level info --no-proxy-headers

Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

StandardOutput=journal
StandardError=journal
SyslogIdentifier=deep-research-web

[Install]
WantedBy=default.target
